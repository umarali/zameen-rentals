{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListBackupsPrefix",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::zameenrentals",
      "Condition": { "StringLike": { "s3:prefix": "backups/*" } }
    },
    {
      "Sid": "WriteBackups",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::zameenrentals/backups/*"
    }
  ]
}
