# TypeSafe Jev listing tags (backend only; never prefix with VITE_)
TYPESAFE_API_KEY=

# PostHog analytics (frontend)
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=
# VITE_ENABLE_ANALYTICS_DEV=1

# Optional Claude search parser; without a key, search uses the regex parser.
ANTHROPIC_API_KEY=
ZR_PARSE_MODEL=claude-haiku-5-5
