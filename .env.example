# TypeSafe Jev listing tags (backend only; never prefix with VITE_)
TYPESAFE_API_KEY=

# PostHog analytics (frontend)
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=
# VITE_ENABLE_ANALYTICS_DEV=1

# Optional Claude search parser; without a key, search uses the regex parser.
ANTHROPIC_API_KEY=
ZR_PARSE_MODEL=claude-haiku-5-5

# Web Bot Auth signing key for the crawler (backend only; never prefix with VITE_).
# Base64 of the raw 32-byte Ed25519 seed (or a PKCS#8 PEM). The matching public key is
# served at /.well-known/http-message-signatures-directory. Leave empty to send
# the fixed ZameenRentalBot User-Agent unsigned. Generate one with:
#   python -m app.botidentity
# Keep the real value out of git: set it in the server's .env only.
ZR_BOT_SIGNING_KEY=
